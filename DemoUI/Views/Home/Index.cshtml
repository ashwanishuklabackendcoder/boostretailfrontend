@{
    ViewData["Title"] = "Home Page";
}

<!-- Main Content Wrapper -->
<div style="display: flex; flex-direction: column; align-items: flex-start; flex: 1 0 0;">


    <!-- Page Top Section (Header area) -->
    <div style="display: flex; flex-direction: column; align-items: center; align-self: stretch;">
        
        <!-- Section Title Bar (under Page Top) -->
        <div style="display: flex; height: 64px; justify-content: space-between; align-items: center;
                    align-self: stretch; border-bottom: 1px solid var(--color-border-horizontal-lines, #DBDBDB);
                    background: var(--color-background-main, #FFF);">

            <!-- Left Section (Inside Page Title Bar) -->
            <div style="display: flex; height: 64px; padding: 0 26px; align-items: center;">

                <div style="display: flex; align-items: center;">
                    <span style="color: var(--color-text-section-title, #000); font-family: Inter, sans-serif;
                          font-size: 18px; font-style: normal; font-weight: 600;
                          line-height: 24px; text-transform: uppercase;">
                            SECTION TITLE
                    </span>
                </div>

            </div>

            <!-- Right Section (Inside Page Title Bar) -->
            <div style="display: flex; padding: 0 24px; justify-content: flex-end; align-items: center; gap: 14px;">

                <div style="display: flex; align-items: center;">
                    <span style="color: var(--color-text-section-title, #000); text-align: right;
                          font-family: Inter, sans-serif; font-size: 15px; font-style: normal; font-weight: 500;
                          line-height: 18px;">
                        Advanced Mode
                    </span>
                </div>

                <!-- Toggle Button Container -->
                <div id="toggleContainer"
                     style="user-select:none;display: flex; width: 42px; height: 22px; align-items: center; cursor: pointer;">

                    <svg id="toggleSwitch" width="42" height="22" viewBox="0 0 42 22" style="cursor:pointer">

                        <!-- Background (OFF default) -->
                        <rect id="toggleBg"
                              x="1" y="1"
                              width="40" height="20"
                              rx="10"
                              fill="#BABABA"
                              stroke="#BABABA"
                              stroke-width="2"
                              style="transition: fill 0.25s;" />

                        <!-- Knob (RIGHT default) -->
                        <rect id="toggleKnob"
                              x="21"
                              y="2"
                              width="18" height="18"
                              rx="9"
                              fill="white"
                              style="transition: all 0.25s;" />
                    </svg>

                </div>


            </div>

        </div>


        <!-- Breadcrumb Bar -->
        <div style="display: flex; height: 50px; justify-content: space-between; align-items: center;
            align-self: stretch; border-bottom: 1px solid var(--color-border-horizontal-lines, #DBDBDB);
            background: var(--color-background-main, #FFF);">

            <!-- Left Side: Breadcrumb Path -->
            <div style="display: flex; padding: 0 26px; align-items: center; align-self: stretch;">
                <!-- Breadcrumbs -->
                <span style="color: var(--color-text-breadcrumbs, #000);
             font-family: Inter, sans-serif;
             font-size: 15px;
             font-style: normal;
             font-weight: 400;
             line-height: 20px; /* 133.333% */
             text-transform: capitalize;">
                    Home > Dashboard
                </span>

            </div>

            <!-- Right Side:  -->
            <div style="display: flex; padding: 0 24px; justify-content: flex-end; align-items: center;
                        font-family: Inter, sans-serif; font-size: 13px; font-weight: 500;
                        color: var(--color-text-\, #000)">
                Text Here
            </div>

        </div>


    </div>


    <!-- Page Bottom Section (Main content area) -->
    <div style="display: flex; padding: 24px; flex-direction: column; align-items: flex-start; gap: 24px; align-self: stretch;">
        @* Add your main dashboard widgets, cards, tables, etc. here *@
    </div>


    <!-- Footer Section -->
    <div style="display: flex; height: 75px; padding: 10px; align-items: flex-start; gap: 10px; align-self: stretch;">
        @* Add your footer text or links here *@
    </div>

</div>

    <script>

    const bg = document.getElementById("toggleBg");
    const knob = document.getElementById("toggleKnob");
    const toggle = document.getElementById("toggleSwitch");

    toggle.addEventListener("click", () => {

        const isOff = knob.getAttribute("x") === "21"; // knob right = OFF

        if (isOff) {
            // Turn ON → knob left, bg blue
            knob.setAttribute("x", "1");
            bg.setAttribute("fill", "#0080FF");
            bg.setAttribute("stroke", "#0080FF");
        } else {
            // Turn OFF → knob right, bg grey
            knob.setAttribute("x", "21");
            bg.setAttribute("fill", "#BABABA");
            bg.setAttribute("stroke", "#BABABA");
        }
    });
    </script>