
@{
    ViewData["Title"] = "Visual Category Checker";
}
<div class="section-title"><h4 class="m-0">Incorrect Data</h4></div>
<div class="breadcrumb-bar">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb m-0 bg-transparent">
            <li class="breadcrumb-item"><a href="#">Incorrect Data</a></li>
            <li class="breadcrumb-item active" aria-current="page">Visual Category Checker</li>
        </ol>
    </nav>
</div>
<div class="container-fluid px-0">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="fw-semibold mb-2 mb-sm-0">Visual Category Checker</h6>
        <div class="d-flex align-items-center gap-2">
            <span class="text-muted small">Number of products: <span id="productCount">0</span></span>
            <div class="dropdown">
                <button class="btn btn-light btn-sm dropdown-toggle" type="button" id="resultsPerPage" data-bs-toggle="dropdown" aria-expanded="false">
                    Results Per Page: <span id="pageSizeDisplay">50</span>
                </button>
                <ul class="dropdown-menu" aria-labelledby="resultsPerPage">
                    <li><a class="dropdown-item page-size-option" href="#" data-size="20">20</a></li>
                    <li><a class="dropdown-item page-size-option" href="#" data-size="50">50</a></li>
                    <li><a class="dropdown-item page-size-option" href="#" data-size="100">100</a></li>
                </ul>
            </div>
        </div>
    </div>

    <!-- 🔹 Category Filters -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
        <div class="col-md-4">
            <select id="category1Dropdown" class="form-select form-select-sm cat1-dropdown">
                <option value="">Category 1</option>
            </select>
        </div>
        <div class="col-md-4">
            <select id="category2Dropdown" class="form-select form-select-sm cat2-dropdown" disabled>
                <option value="">Category 2</option>
            </select>
        </div>
        <div class="col-md-4">
            <select id="category3Dropdown" class="form-select form-select-sm cat3-dropdown" disabled>
                <option value="">Category 3</option>
            </select>
        </div>
    </div>

    <!-- 🔹 Product Grid -->
    <div id="productGrid" class="product-grid scrollable-grid ">
    </div>
</div>

<!-- 🔹 Edit Product Modal -->
<div class="modal fade" id="editProductModal" tabindex="-1" aria-labelledby="editProductLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-semibold" id="editProductLabel">Edit Product</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editProductForm">
                    <input type="hidden" id="editProductId">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small">Title</label>
                            <input type="text" class="form-control form-control-sm" id="editTitle">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small">Model</label>
                            <input type="text" class="form-control form-control-sm" id="editModel">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small">Category</label>
                            <input type="text" class="form-control form-control-sm" id="editCategory">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small">Price</label>
                            <input type="number" step="0.01" class="form-control form-control-sm" id="editPrice">
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small">Image</label>
                            <input type="file" class="form-control form-control-sm" id="editImage">
                            <div class="mt-2">
                                <img id="previewImage" src="" alt="Preview" class="img-thumbnail" style="max-height:120px;">
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="saveProductChanges" class="btn btn-primary btn-sm">Save Changes</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        const apiCategoriesUrl = "https://simapi.runasp.net/api/Category/GetCategoryByParentId";
        const apiProductsUrl = "https://simapi.runasp.net/api/Catalogue/GetByCategories";
        const apiUpdateProductUrl = "https://simapi.runasp.net/api/Catalogue/UpdateVisualCategory";
        // const apiUpdateProductUrl = "http://localhost:5265/api/Catalogue/UpdateVisualCategory";
        let currentCategories = { cat1: null, cat2: null, cat3: null };
        // 🌐 Load Categories (dynamic)
        function populateCategoryDropdown(parentId, targetDropdown) {
            const url = parentId ? `${apiCategoriesUrl}?parentId=${parentId}` : apiCategoriesUrl;
            const dropdown = $(targetDropdown);
            dropdown.html('<option>Loading...</option>').prop('disabled', true);
            fetch(url)
                .then(res => res.json())
                .then(data => {
                    dropdown.html('<option value="">Choose...</option>');
                    if (data && data.length > 0) {
                        data.forEach(item => dropdown.append(`<option value="${item.id}">${item.name}</option>`));
                        dropdown.prop('disabled', false);
                    } else {
                        dropdown.html('<option value="">No options</option>');
                    }
                })
                .catch(() => dropdown.html('<option>Error</option>'));
        }

        // 🌐 Load Products
        function loadProducts(cat1, cat2, cat3) {
            debugger
            $('#productGrid').html('<div class="text-center py-5 w-100"><div class="spinner-border text-primary" role="status"></div></div>');
            const params = new URLSearchParams();
            if (cat1) params.append("Category1Id", cat1);
            if (cat2) params.append("Category2Id", cat2);
            if (cat3) params.append("Category3Id", cat3);
            const url = `${apiProductsUrl}?${params.toString()}`;
            fetch(url)
                .then(res => res.json())
                .then(data => renderProducts(data))
                .catch(() => $('#productGrid').html('<p class="text-danger text-center">Error loading products</p>'));
        }

        // 🖼️ Render Product Grid
        function renderProducts(products) {
            const grid = $('#productGrid');
            grid.empty();
            if (!products || products.length === 0) {
                grid.html('<p class="text-center text-muted py-4">No products found.</p>');
                $('#productCount').text('0');
                return;
            }
            $('#productCount').text(products.length);

            products.forEach(p => {
                const imgSrc = p.images ? p.images.split(',')[0] : '/no-image.png';
                const card = `
                <div >
                    <div class="card h-100 border-0 shadow-sm product-card text-center">
                        <div class="ratio ratio-1x1 bg-light position-relative">
                            <img src="${imgSrc}" alt="${p.title}" class="img-fluid p-2">
                            <div class="edit-overlay">
                                <button class="edit-btn btn-sm" onclick='openEditModal(${JSON.stringify(p)})'>Edit</button>
                            </div>
                        </div>
                        <div class="card-body text-center p-2">
                            <p class="fw-semibold mb-1 small text-truncate">${p.title || 'Title Goes Here'}</p>
                            <p class="mb-0 small text-muted">${p.year || ''}</p>
                            <p class="mb-0 small text-muted">${p.category2 || ''}</p>
                            <p class="fw-bold small mb-0">${p.price?.toFixed(2) || '0.00'}</p>
                        </div>
                    </div>
                </div>`;
                grid.append(card);
            });
        }

        // 🧩 Open Edit Modal
        function openEditModal(product) {
            $('#editProductId').val(product.mpn);  
            $('#editTitle').val(product.title);
            $('#editModel').val(product.year);
            $('#editCategory').val(product.category2);
            $('#editPrice').val(product.price);
            $('#previewImage').attr('src', product.images ? product.images.split(',')[0] : '/no-image.png');
            const modal = new bootstrap.Modal(document.getElementById('editProductModal'));
            modal.show();
        }
           // 🧩 Save Product Changes
        // $('#saveProductChanges').click(function () {
        //     debugger;
        //     const id = $('#editProductId').val();
        //     const title = $('#editTitle').val();
        //     const model = $('#editModel').val();
        //    // const category = $('#editCategory').val();
        //     const price = parseFloat($('#editPrice').val());
        //     const imageFile = $('#editImage')[0].files[0];

        //     const formData = new FormData();
        //     formData.append("Id", id);
        //     formData.append("Title", title);
        //     formData.append("Model", model);
        //    // formData.append("CategoryName", category);
        //     formData.append("Price", price);
        //     if (imageFile) formData.append("Image", imageFile);

        //     fetch(apiUpdateProductUrl, {
        //         method: "PUT",
        //         body: formData
        //     })
        //     .then(res => {
        //         if (!res.ok) throw new Error("Failed to update product");
        //         return res.json();
        //     })
        //     .then(() => {
        //         bootstrap.Modal.getInstance(document.getElementById('editProductModal')).hide();
        //         loadProducts(currentCategories.cat1, currentCategories.cat2, currentCategories.cat3);
        //     })
        //     .catch(err => alert("Error updating product: " + err.message));
        // });


        // 🔹 Category change events

          $('#saveProductChanges').click(async function () {
            

            const id = $('#editProductId').val();
            const title = $('#editTitle').val();
            const model = $('#editModel').val();
            const price = parseFloat($('#editPrice').val());
            const imageFile = $('#editImage')[0].files[0];

            let imagePath = null;

            // 1️⃣ Upload image to UI server first (if selected)
            if (imageFile) {
                const uploadForm = new FormData();
                uploadForm.append("file", imageFile);

                const uploadRes = await fetch("/upload/product-image", {
                    method: "POST",
                    body: uploadForm
                });

                if (!uploadRes.ok) {
                    alert("Image upload failed.");
                    return;
                }

                const uploadData = await uploadRes.json();
                imagePath = uploadData.path; 
            }

            // 2️⃣ Now send data to API with path only
            const productPayload = {
                MPN: id,
                Title: title,
                Model: model,
                Price: price,
                Images: imagePath // path only
            };

            const res = await fetch(apiUpdateProductUrl, {
                method: "PUT",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify(productPayload)
            });

            if (!res.ok) {
                alert("Failed to update product.");
                return;
            }

            const data = await res.json();
            alert(data.message || "Product updated successfully!");
            bootstrap.Modal.getInstance(document.getElementById('editProductModal')).hide();
            loadProducts(currentCategories.cat1, currentCategories.cat2, currentCategories.cat3);
        });

        $(document).on('change', '#category1Dropdown', function () {
            const parentId = $(this).val();
            populateCategoryDropdown(parentId, '#category2Dropdown');
            $('#category3Dropdown').html('<option value="">Category 3</option>').prop('disabled', true);
            loadProducts(parentId);
        });

        $(document).on('change', '#category2Dropdown', function () {
            const parentId = $(this).val();
            populateCategoryDropdown(parentId, '#category3Dropdown');
            loadProducts($('#category1Dropdown').val(), parentId);
        });

        $(document).on('change', '#category3Dropdown', function () {
            loadProducts($('#category1Dropdown').val(), $('#category2Dropdown').val(), $(this).val());
        });

        // 🔹 Init
        $(document).ready(function () {
            populateCategoryDropdown(null, '#category1Dropdown');
            loadProducts();
        });
    </script>
}
