                    // Label text
                    const span = document.createElement("span");
                    span.textContent = def.title;
                    span.style.cssText = ` font-size: 12pt; color: #555; cursor: pointer; `;

                    wrapper.appendChild(checkbox);
                    wrapper.appendChild(span);
                    list.appendChild(wrapper);

