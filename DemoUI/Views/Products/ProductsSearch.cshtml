        const toggleBtn = document.getElementById("toggleBtn");

        const columnMenu = document.getElementById("columnsPopup");
        const list = document.getElementById("columnCheckboxList");


            // 🔹 Build checkboxes AFTER Tabulator fully loads
            table.on("tableBuilt", function () {

                list.innerHTML = "";

                table.getColumns().forEach(col => {

                    const def = col.getDefinition();
                    if (!def.title) return;

                    // Wrapper for label + checkbox (your design)
                    const wrapper = document.createElement("label");
                    wrapper.style.cssText = ` display: flex; align-items: center; gap: 8px; padding: 4px 0; `;

                    // Checkbox
                    const checkbox = document.createElement("input");
                    checkbox.type = "checkbox";
