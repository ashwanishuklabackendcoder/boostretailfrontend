        input.style.fontFamily = "Inter, sans-serif";
        input.style.fontSize = "11pt";
        input.style.color = "#555";

        input.addEventListener("keyup", () => {
            success(input.value);
        });

        let span = document.createElement("span");
        span.className = "cursor-pointer";
        span.style.outline = "none";
        span.style.flexShrink = "0";

        let btn = document.createElement("button");
        btn.style.marginLeft = "3px";
        btn.style.height = "30px";
        btn.style.width = "28px";
        btn.style.cursor = "pointer";
        btn.style.userSelect = "none";
        btn.style.border = "none";
        btn.style.background = "transparent";
        btn.style.flexShrink = "0";

        btn.innerHTML = `
            <svg xmlns="http://www.w3.org/2000/svg" fill="none"
            viewBox="0 0 24 24" stroke-width="1.5"
            stroke="currentColor" class="text-[#9c9c9c]"
            style="width:22px; height:22px; color:#DBDBDB">
            <path stroke-linecap="round" stroke-linejoin="round"
                d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 0 1-.659 1.591l-5.432 5.432a2.25 2.25 0 0 0-.659 1.591v2.927a2.25 2.25 0 0 1-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 0 0-.659-1.591L3.659 7.409A2.25 2.25 0 0 1 3 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0 1 12 3Z" />
        </svg>
        `;

        btn.addEventListener("click", (e) => {
            e.stopPropagation();
            showFilterPopup(e, cell, success);
        });

        span.appendChild(btn);
        wrapper.appendChild(input);
        wrapper.appendChild(span);

        return wrapper;
    }

    function showFilterPopup(e, cell, success) {
        const popup = document.getElementById("filterPopup");
        const column = cell.getColumn();
        const colIndex = table.getColumns().indexOf(column);
        const totalCols = table.getColumns().length;

        let left = e.clientX;
        let top = e.clientY;
        const popupWidth = popup.offsetWidth || 220;

        if (colIndex >= totalCols - 3) {
            left = e.clientX - popupWidth - 10;
        }

        popup.style.left = left + "px";
        popup.style.top = top + "px";
        popup.style.display = (popup.style.display === "none" || popup.style.display === "") ? "block" : "none";

        // store the success callback and the column field for when user selects mode
        popup._filterCallback = success;
        popup._columnField = column.getField();

        setTimeout(() => {
            window.onclick = function (evt) {
                if (!popup.contains(evt.target)) {
                    popup.style.display = "none";
                    window.onclick = null;
                }
            };
        }, 50);
    }

    function selectFilterMode(btn) {
        // reset
        document.querySelectorAll('#filterOptions button').forEach(b => {
            b.dataset.selected = "";
            b.style.background = "transparent";
            b.style.color = "#555";
            b.querySelector('.icon-box').innerHTML = "";
        });

        btn.dataset.selected = "true";
        btn.style.background = "#0080ff";
        btn.style.color = "#fff";
        btn.querySelector('.icon-box').innerHTML = `
            <svg xmlns="http://www.w3.org/2000/svg"
                 viewBox="0 0 24 24" stroke-width="1.5"
                 stroke="currentColor" fill="none"
                 style="width:16px;height:16px;color:white;">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="m4.5 12.75 6 6 9-13.5" />
            </svg>
        `;

        const popup = document.getElementById("filterPopup");
        const mode = btn.getAttribute("data-mode");
        const success = popup._filterCallback;
        const colField = popup._columnField;

        // store mode for this column (so headerFilterFunc can use it)
        headerFilterModes[colField] = mode;

        // call the header filter success with the current input value in the header
        if (typeof success === "function") {
            // find the header input value for this column
            const headerInput = document.querySelector(`div.tabulator-header .tabulator-col[tabulator-field="${colField}"] input`);
            const value = headerInput ? headerInput.value : "";
            // call callback with value (it will trigger headerFilterFunc)
            success(value);
        }

        popup.style.display = "none";
    }

    function myFilterFunc(headerValue, rowValue, rowData, params) {

        if (!headerValue) return true;
        headerValue = (headerValue + "").toLowerCase();
        rowValue = (rowValue + "").toLowerCase();

        const mode = headerFilterModes[params.mode] || "like";
        console.log("mode : ",mode);

        switch (mode) {
            case "like":      return rowValue.includes(headerValue);
            case "starts":    return rowValue.startsWith(headerValue);
            case "equals":    return rowValue === headerValue;
            case "ends":      return rowValue.endsWith(headerValue);
            case "notlike":   return !rowValue.includes(headerValue);
            case "notequals": return rowValue !== headerValue;
            default:          return true;
        }
    }

    function toggleFilterPopup() {
        const popup = document.getElementById("filterPopup");
        popup.style.display = (popup.style.display === "none" || popup.style.display === "") ? "block" : "none";
    }



