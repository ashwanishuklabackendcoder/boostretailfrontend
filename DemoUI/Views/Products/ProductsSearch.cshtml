    function wireCheckboxes() {
        // Remove previous listeners (simple approach: clone node)
        document.querySelectorAll("#productTable .selectProduct").forEach(cb => {
            const newCb = cb.cloneNode(true);
            cb.parentNode.replaceChild(newCb, cb);
        });

        // Attach change listeners
        document.querySelectorAll("#productTable .selectProduct").forEach(cb => {
            cb.addEventListener("change", function () {
                // if any unchecked → uncheck selectAllHeader
                const headerCb = document.getElementById("selectAllHeader");
                const all = document.querySelectorAll("#productTable .selectProduct");
                const checked = document.querySelectorAll("#productTable .selectProduct:checked");
                if (headerCb) headerCb.checked = (all.length > 0 && checked.length === all.length);
            });
        });

        // Hook into the header select-all (the one rendered inside Tabulator header)
        const headerAll = document.getElementById("selectAllHeader");
        if (headerAll) {
            headerAll.addEventListener("change", function () {
                const checked = this.checked;
                document.querySelectorAll("#productTable .selectProduct").forEach(cb => cb.checked = checked);
            });
        }
    }
       
    // Search and load products into Tabulator
    async function searchProducts() {
        
        const query = new URLSearchParams({
            // Supplier: document.getElementById("supplierDropdown").value,
            // BrandId: document.getElementById("brandDropdown").value,
            // CategoryId: document.getElementById("categoryDropdown").value,
            // Year: document.getElementById("yearDropdown").value,
            // MPN: document.getElementById("mpnInput").value,
            // Barcode: document.getElementById("barcodeInput").value,
            // Title: document.getElementById("titleInput").value
        });

        const filter = {
            // SearchTerm: document.getElementById("searchBox").value || "",
            // Categorized: document.getElementById("categorized").checked ? true :
            //              document.getElementById("uncategorized").checked ? false : null,
            // SingleResultPerModel: document.getElementById("singleResult").checked,
            PageNumber: currentPage,
            PageSize: pageSize
        };

        try {
            // const products = await fetch(`${productsApi}?${query}`, {
            //     headers: {
            //         "Authorization": token ? `Bearer ${token.replace(/"/g, '')}` : ""
            //     }
            // }).then(r => r.json());

            const response = await fetch(apiUrl, {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "Authorization": `Bearer ${token}`
                },
                body: JSON.stringify(filter)
            });


            if (!response.ok) throw new Error("Failed to fetch products.");

            const data = await response.json();
            const products = data.items || [];
            const totalCount = data.totalCount || 0;
            const totalPages = Math.ceil(totalCount / pageSize);

            // Make sure to pass an array (Tabulator requires array)
            //const rows = Array.isArray(products) ? products : (products.items || []);
            const rows = products;
            table.replaceData(rows);

            // Update UI
            document.getElementById("pgTotal").textContent = `of ${totalPages}`;
            totalPage = totalPages;
            document.getElementById("totalProducts").textContent = `${totalCount}`;

        } catch (err) {
            console.error("Error loading products:", err);
        }
    }

    
    // Save selected products (reads native checkboxes inside Tabulator cells)
    async function saveSelectedProducts() {
        
        const selectedProducts = Array.from(document.querySelectorAll("#productTable .selectProduct:checked")).map(cb => {
            const row = cb.closest(".tabulator-row");
            // Tabulator row children mapping: find visible cells and their values
            // Simpler: read cells by querying text content near checkbox; we know column order
            // But best to get Tabulator row data using the row's DOM attribute
            let mpn = cb.dataset.mpn;
            // attempt to find price and title from sibling cells in the row DOM
            // Tabulator cell DOM structure: .tabulator-row > .tabulator-cell
            const cells = row ? Array.from(row.querySelectorAll(".tabulator-cell")) : [];
            // cell index 0 was checkbox, so price likely at last cell index
            const titleCell = cells[2] ? cells[2].textContent.trim() : "";
            const priceCell = cells[cells.length - 1] ? cells[cells.length - 1].textContent.trim() : "0";
            return {
                MPN: mpn,
                ProductPrice: parseFloat(priceCell) || 0,
                PShortDes: titleCell
            };
        });

        if (selectedProducts.length === 0) {
            alert("Please select at least one product.");
            return;
        }

        try {
            const response = await fetch(saveProductsApi, {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "Authorization": token ? `Bearer ${token.replace(/"/g, '')}` : ""
                },
                body: JSON.stringify(selectedProducts)
            });

            const result = await response.json();

            if (response.ok) {
                alert(result.message || "Products saved successfully!");
            } else {
                alert("Error saving products: " + JSON.stringify(result));
            }
        } catch (err) {
            console.error("Error saving products:", err);
            alert("An error occurred while saving products.");
        }
    }

    async function SaveSelectedProducts() {

        const selectedProducts = table.getSelectedData().map(p => ({
            MPN: p.mpn || p.MPN,
            ProductPrice: parseFloat(p.price || p.ProductPrice || 0),
            PShortDes: p.title || p.PShortDes || ""
        }));

        if (selectedProducts.length === 0) {
            alert("Please select at least one product.");
            return;
        }

        try {
            const response = await fetch(saveProductsApi, {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "Authorization": token ? `Bearer ${token.replace(/"/g, '')}` : ""
                },
                body: JSON.stringify(selectedProducts)
            });

            const result = await response.json();

            if (response.ok) {
                alert(result.message || "Products saved successfully!");
                ClearSelectedProducts();
            } else {
                alert("Error saving products: " + JSON.stringify(result));
            }

        } catch (err) {
            console.error("Error saving products:", err);
            alert("An error occurred while saving products.");
        }
    }

    function ClearSelectedProducts(){
        table.deselectRow();
                         document.getElementById("clearBtn").style.display = "none";
                 document.getElementById("saveBtn").style.display = "none";
    }


    const numericFields = ["price", "cost"]; // add field names that should use numeric filter


