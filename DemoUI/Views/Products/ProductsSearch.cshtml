<style>
    .stock-box {
        min-width: 100px;
        border: 1px solid #89b9ff;
        border-radius: 8px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 6px 0;
        background: white;
        transition: all 0.25s ease;
        cursor: pointer;
    }

        .stock-box:hover {
            background: #007bff;
            color: white;
            transform: translateY(-3px);
        }

        .stock-box div:first-child {
            font-size: 20px;
            font-weight: 600;
            transition: color 0.25s ease;
        }

        .stock-box div:last-child {
            font-size: 12px;
            color: #555;
            transition: color 0.25s ease;
        }

        .stock-box:hover div:last-child {
            color: #e8e8e8; /* softer white for subtitle */
        }

    .action-btn {
        background-color: #0080ff;
        color: white;
        border-radius: 9999px;
        padding: 8px 16px;
        border: 1px solid #0080ff;
        font-family: Inter, sans-serif;
        font-weight: 900;
        font-size: 9pt;
        cursor: pointer;
        transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.15s ease;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        /* Hover effect */
        .action-btn:hover {
            background-color: white;
            color: #0080ff;
            border-color: #0080ff;
            transform: translateY(-2px);
        }


</style>

<!-- Main Content Wrapper -->
<div class="container-fluid p-0" style="width:100%; overflow-x:hidden;">

    <!-- Page Top Products (Header area) -->
    <div style="display: flex; flex-direction: column; align-items: center; align-self: stretch;">

        <!-- Products Title Bar (under Page Top) -->
        <div style="display: flex; height: 64px; justify-content: space-between; align-items: center;
                    align-self: stretch; border-bottom: 1px solid var(--color-border-horizontal-lines, #DBDBDB);
                    background: var(--color-background-main, #FFF);">

            <!-- Left Products (Inside Page Title Bar) -->
            <div style="display: flex; height: 64px; padding: 0 26px; align-items: center;">

                <div style="display: flex; align-items: center;">
                    <span style="color: var(--color-text-section-title, #000); font-family: Inter, sans-serif;
