                    columnMenu.style.display = "none";
                    clearColumnFilter();
                    resetAllColumnCheckboxes();
                }
            });

            // live filtering (show only matching checkboxes)
            document.getElementById("columnFilter").addEventListener("input", function() {
                const search = this.value.toLowerCase();
