@{
    ViewData["Title"] = "SIM Products";
}


<!-- Main Content Wrapper -->
<div class="container-fluid p-0" style="width:100%; overflow-x:hidden;">

    <!-- Page Top My Products (Header area) -->
    <div style="display: flex; flex-direction: column; align-items: center; align-self: stretch;">

        <!-- My Products Title Bar (under Page Top) -->
        <div style="display: flex; height: 64px; justify-content: space-between; align-items: center;
                    align-self: stretch; border-bottom: 1px solid var(--color-border-horizontal-lines, #DBDBDB);
                    background: var(--color-background-main, #FFF);">

            <!-- Left My Products (Inside Page Title Bar) -->
            <div style="display: flex; height: 64px; padding: 0 26px; align-items: center;">

                <div style="display: flex; align-items: center;">
                    <span style="color: var(--color-text-section-title, #000); font-family: Inter, sans-serif;
                          font-size: 18px; font-style: normal; font-weight: 600;
                          line-height: 24px; text-transform: uppercase;">
                        My Products
                    </span>
                </div>

            </div>

            <!-- Right Section (Inside Page Title Bar) -->
            <div style="display: flex; padding: 0 24px; justify-content: flex-end; align-items: center; gap: 14px;">

                <div style="display: flex; align-items: center;">
                    <span style="color: var(--color-text-section-title, #000); text-align: right;
                          font-family: Inter, sans-serif; font-size: 15px; font-style: normal; font-weight: 500;
                          line-height: 18px;">
                        Advanced Mode
                    </span>
                </div>

                <!-- Toggle Button Container -->
                <div id="toggleContainer"
                     style="user-select:none;display: flex; width: 42px; height: 22px; align-items: center; cursor: pointer;">

                    <svg id="toggleSwitch" width="42" height="22" viewBox="0 0 42 22" style="cursor:pointer">

                        <!-- Background (OFF default) -->
                        <rect id="toggleBg"
                              x="1" y="1"
                              width="40" height="20"
                              rx="10"
                              fill="#BABABA"
                              stroke="#BABABA"
                              stroke-width="2"
                              style="transition: fill 0.25s;" />

                        <!-- Knob (RIGHT default) -->
                        <rect id="toggleKnob"
                              x="21"
                              y="2"
                              width="18" height="18"
                              rx="9"
                              fill="white"
                              style="transition: all 0.25s;" />
                    </svg>

                </div>

            </div>

        </div>


        <!-- Breadcrumb Bar -->
        <div style="display: flex; height: 50px; justify-content: space-between; align-items: center;
            align-self: stretch; border-bottom: 1px solid var(--color-border-horizontal-lines, #DBDBDB);
            background: var(--color-background-main, #FFF);">

            <!-- Left Side: Breadcrumb Path -->
            <div style="display: flex; padding: 0 26px; align-items: center; align-self: stretch;">
                <!-- Breadcrumbs -->
                <span style="font-family: Inter, sans-serif;font-size: 15px; font-style: normal; font-weight: 400;
                             line-height: 20px; cursor:pointer; text-transform: capitalize; margin-right:5px">
                    <a style="color: var(--color-text-breadcrumbs, #000); text-decoration:none;" href="#">
                        My Products
                    </a>
                </span>

                <span style="color: var(--color-text-breadcrumbs, #000); font-family: Inter, sans-serif;
                            font-size: 15px; font-style: normal; font-weight: 400; line-height: 20px;
                            text-transform: capitalize;">
                    > Maintain Products
                </span>

            </div>

            <!-- Right Side:  -->
            <div style="display: flex; padding: 0 24px; justify-content: flex-end; align-items: center;">
                <span style="color: var(--color-text-breadcrumbs, #000); font-family: Inter, sans-serif;
                            font-size: 15px; font-style: normal; font-weight: 400; line-height: 20px;
                            text-transform: capitalize;">
                    Total Products : <span id="totalProducts">500,000</span>
                </span>
            </div>

        </div>

    </div>

    <!-- Filter Section Search -->
    <div style="display: flex; flex-direction: column; align-items: center; align-self: stretch;">

        <!-- 🔹 Filter Section -->
        <div style="display: flex; height: 50px; justify-content: space-between; align-items: center;
                align-self: stretch; background: var(--color-background-main, #FFF);">

            <!-- Search Text -->
            <div style="display: flex; height: 50px; padding: 0 26px; align-items: center;">
                <span style="color: var(--color-text-section-title, #000);
                             font-family: Inter, sans-serif;
                             font-size: 18px;
                             font-style: normal;
                             font-weight: 600;
                             line-height: 24px;">
                    Search
                </span>
            </div>

        </div>


        <div style="display: flex; height: 50px; justify-content: space-between; align-items: center;
            align-self: stretch; background: var(--color-background-main, #FFF); padding: 0 26px; gap: 20px;">

            <!-- Left - Filter Section -->
            <div class="d-flex align-items-center gap-3">

                <!-- Search Input -->
                <input type="text" id="searchBox" class="form-control"
                       placeholder="Enter MPN / Barcode / Title / Model"
                       style="width: 400px;" />

                <!-- SVG Icon -->
                <div style="cursor: pointer; display: flex; align-items: center;">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none"
                         viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
                         width="22" height="22">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M9 15 3 9m0 0 6-6M3 9h12a6 6 0 0 1 0 12h-3" />
                    </svg>
                </div>

                <!-- Categorized -->
                <div id="categorized" class="form-check" style="display: flex; align-items: center; gap: 10px; margin: 0; padding: 0;">
                    <input class="form-check-input" type="checkbox" id="categorized"
                           style="margin: 0; position: relative; top: 0;">
                    <label class="form-check-label" for="categorized"
                           style="margin: 0; line-height: 1; display: flex; align-items: center; font-size: 15px;
                       font-family: Inter, sans-serif;">
                        Categorized
                    </label>
                </div>


                <!-- Uncategorized -->
                <div id="uncategorized" class="form-check" style="display: flex; align-items: center; gap: 10px; margin: 0; padding: 0;">
                    <input class="form-check-input" type="checkbox" id="uncategorized"
                           style="margin: 0; position: relative; top: 0;">
                    <label class="form-check-label" for="uncategorized"
                           style="margin: 0; line-height: 1; display: flex; align-items: center; font-size: 15px;
                       font-family: Inter, sans-serif;">
                        Uncategorized
                    </label>
                </div>

                <!-- Single per Model -->
                <div id="singleResult" class="form-check" style="display: flex; align-items: center; gap: 10px; margin: 0; padding: 0;">
                    <input class="form-check-input" type="checkbox" id="singleResult"
                           style="margin: 0; position: relative; top: 0;">
                    <label class="form-check-label" for="singleResult"
                           style="margin: 0; line-height: 1; display: flex; align-items: center; font-size: 15px;
                       font-family: Inter, sans-serif;">
                        Single per Model
                    </label>
                </div>

            </div>

            <!-- Right - Page Selction Dropdown -->
            <div style="display: flex; justify-content: flex-end; align-items: center; gap: 14px;position: relative;">

                <div style="display: flex; align-items: center; gap: 10px; font-family: Inter, sans-serif; font-size: 13px;">
                    <label class="me-2">Results per Page:</label>
                    <select id="pageSize" class="form-select" style="width: 70px; height: 32px; font-size: 13px; padding: 2px 6px;">
                        <option>25</option>
                        <option>50</option>
                        <option>100</option>
                        <option>500</option>
                    </select>
                </div>

            </div>

        </div>

    </div>

    <div class="container-fluid mt-3">

        <!-- 🔹 Table -->
        <div class="table-responsive scroll-table">
            <table class="table table-striped table-bordered" id="productTable">
                <thead class="table-dark">
                    <tr>
                        <th>MPN</th>
                        <th>Title</th>
                        <th>Brand</th>
                        <th>Supplier</th>
                        <th>Size</th>
                        <th>Colour</th>
                        <th>Year</th>
                        <th>Cost</th>
                        <th>Price</th>
                        <th>Category1</th>
                        <th>Category2</th>
                        <th>Category3</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

    </div>

    <!-- 🔹 Pagination -->
    <div class="d-flex align-items-center justify-content-between px-4 mb-3"
         style="height: 50px; background: #fff; margin-top:20px;">

        <!-- Center: Custom Pagination (Your Styled UI) -->
        <div class="d-flex align-items-center gap-3">

            <button id="prevBtn" style="background-color: #0080ff; color: white; border-radius: 9999px; padding: 8px 16px;
                                 border: 1px solid #0080ff; font-family: Inter, sans-serif; font-weight: 700; font-size: 9pt;
                                 cursor: pointer; transition: background-color 0.2s ease, border-color 0.2s ease;">
                ◀ PREV
            </button>

            <span style="font-family: Inter, sans-serif; font-weight: 400; font-size: 10pt;">
                Page
            </span>

            <input readonly id="pgInput" style="width: 70px; padding: 8px 8px; font-family: Inter, sans-serif; font-size: 11pt;
                                color: #555; text-align: center; border: 1px solid #dbdbdb; border-radius: 6px;
                                outline: none;" value="1" />

            <span id="pgTotal" style="font-family: Inter, sans-serif; font-weight: 400; font-size: 10pt;">
                of 1
            </span>

            <button id="nextBtn" style=" background-color: #0080ff; color: white; border-radius: 9999px; padding: 8px 16px;
                                 border: 1px solid #0080ff; font-family: Inter, sans-serif; font-weight: 700; font-size: 9pt;
                                 cursor: pointer; transition: background-color 0.2s ease, border-color 0.2s ease; ">
                NEXT ▶
            </button>

        </div>


        <!-- Right Side (Empty but keeps even spacing like your layout) -->
        <div></div>

    </div>

</div>

