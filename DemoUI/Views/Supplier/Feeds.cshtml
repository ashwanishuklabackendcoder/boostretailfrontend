@model IEnumerable<DemoUI.Models.SupplierFeed>

@{
    ViewData["Title"] = "Supplier Feeds";
}

<!-- Main Content Wrapper -->
<div class="container-fluid p-0" style="width:100%; overflow-x:hidden;">

    <!-- Page Top Supplier Feeds (Header area) -->
    <div style="display: flex; flex-direction: column; align-items: center; align-self: stretch;">

        <!-- Supplier Feeds Title Bar (under Page Top) -->
        <div style="display: flex; height: 64px; justify-content: space-between; align-items: center;
                    align-self: stretch; border-bottom: 1px solid var(--color-border-horizontal-lines, #DBDBDB);
                    background: var(--color-background-main, #FFF);">

            <!-- Left Supplier Feeds (Inside Page Title Bar) -->
            <div style="display: flex; height: 64px; padding: 0 26px; align-items: center;">

                <div style="display: flex; align-items: center;">
                    <span style="color: var(--color-text-section-title, #000); font-family: Inter, sans-serif;
                          font-size: 18px; font-style: normal; font-weight: 600;
                          line-height: 24px; text-transform: uppercase;">
                        Supplier Feeds
                    </span>
                </div>

            </div>

            <!-- Right Section (Inside Page Title Bar) -->
            <div style="display: flex; padding: 0 24px; justify-content: flex-end; align-items: center; gap: 14px;">

                <div style="display: flex; align-items: center;">
                    <span style="color: var(--color-text-section-title, #000); text-align: right;
                          font-family: Inter, sans-serif; font-size: 15px; font-style: normal; font-weight: 500;
                          line-height: 18px;">
                        Advanced Mode
                    </span>
                </div>

                <!-- Toggle Button Container -->
                <div id="toggleContainer"
                     style="user-select:none;display: flex; width: 42px; height: 22px; align-items: center; cursor: pointer;">

                    <svg id="toggleSwitch" width="42" height="22" viewBox="0 0 42 22" style="cursor:pointer">

                        <!-- Background (OFF default) -->
                        <rect id="toggleBg"
                              x="1" y="1"
                              width="40" height="20"
                              rx="10"
                              fill="#BABABA"
                              stroke="#BABABA"
                              stroke-width="2"
                              style="transition: fill 0.25s;" />

                        <!-- Knob (RIGHT default) -->
                        <rect id="toggleKnob"
                              x="21"
                              y="2"
                              width="18" height="18"
                              rx="9"
                              fill="white"
                              style="transition: all 0.25s;" />
                    </svg>

                </div>

            </div>

        </div>


        <!-- Breadcrumb Bar -->
        <div style="display: flex; height: 50px; justify-content: space-between; align-items: center;
            align-self: stretch; border-bottom: 1px solid var(--color-border-horizontal-lines, #DBDBDB);
            background: var(--color-background-main, #FFF);">

            <!-- Left Side: Breadcrumb Path -->
            <div style="display: flex; padding: 0 26px; align-items: center; align-self: stretch;">
                <!-- Breadcrumbs -->
                <span style="font-family: Inter, sans-serif;font-size: 15px; font-style: normal; font-weight: 400;
                             line-height: 20px; cursor:pointer; text-transform: capitalize; margin-right:5px">
                    <a style="color: var(--color-text-breadcrumbs, #000); text-decoration:none;" href="#">
                        Supplier Feeds
                    </a>
                </span>

                <span style="color: var(--color-text-breadcrumbs, #000); font-family: Inter, sans-serif;
                            font-size: 15px; font-style: normal; font-weight: 400; line-height: 20px;
                            text-transform: capitalize;">
                    > Maintain Supplier Feeds
                </span>

            </div>

            <!-- Right Side:  -->
            <div style="display: flex; padding: 0 24px; justify-content: flex-end; align-items: center;">
                <span style="color: var(--color-text-breadcrumbs, #000); font-family: Inter, sans-serif;
                            font-size: 15px; font-style: normal; font-weight: 400; line-height: 20px;
                            text-transform: capitalize; margin-right:25px">
                    @* Total Products : <span id="totalProducts">500,000</span> *@
                </span>
            </div>

        </div>

    </div>

    <div class="container-fluid mt-3" style="padding: 0 26px 0 24px">
        <div class="container-fluid px-0">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="mb-0">Create supplier Feed</h6>
                <button class="btn btn-primary btn-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                    </svg>
                </button>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered align-middle supplier-table">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Supplier</th>
                            <th>Feed Name</th>
                            <th>Feed Address</th>
                            <th>API Key</th>
                            <th>Username</th>
                            <th>Password</th>
                            <th>Active</th>
                            <th>Delete</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var isActiveRow = item.Id == 1 ? "active-row" : "";
                            <tr class="@isActiveRow">
                                <td>@item.Id</td>
                                <td><input class="form-control form-control-sm" value="@item.Supplier" /></td>
                                <td><input class="form-control form-control-sm" value="@item.FeedName" /></td>
                                <td><input class="form-control form-control-sm" value="@item.FeedAddress" /></td>
                                <td><input class="form-control form-control-sm" value="@item.ApiKey" /></td>
                                <td><input class="form-control form-control-sm" value="@item.Username" /></td>
                                <td><input class="form-control form-control-sm" value="@item.Password" /></td>
                                <td class="text-center">
                                    <input class="form-check-input" type="checkbox" checked="@item.Active" />
                                </td>
                                <td class="text-center">
                                    <button class="delete-btn btn btn-sm text-danger"><i class="fa fa-trash"></i></button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="mt-4">
                <h6 class="fw-bold">Giant Main Feed Information</h6>
                <div class="text-muted small">
                    <p><strong>Last Updated:</strong> 20/07/2025 13:45</p>
                    <p><strong>New Products:</strong> 27</p>
                    <p><strong>Uncategorised products:</strong> 5</p>
                    <p><strong>Category conflicts:</strong> 1</p>
                    <p><strong>Missing Key Data:</strong> 2</p>
                </div>
            </div>

        </div>

    </div>

</div>




@section Scripts {
    <script>
        // highlight selected row when clicked
        document.querySelectorAll('.supplier-table tbody tr').forEach(row => {
            row.addEventListener('click', () => {
                document.querySelectorAll('.supplier-table tbody tr').forEach(r => r.classList.remove('active-row'));
                row.classList.add('active-row');

                // document.getElementById("delete-btn").remove.classList("text-danger");
                // document.getElementById("delete-btn").add.classList("text-default");
            });
        });

        const bg = document.getElementById("toggleBg");
        const knob = document.getElementById("toggleKnob");
        const toggle = document.getElementById("toggleSwitch");

        toggle.addEventListener("click", () => {

            const isOff = knob.getAttribute("x") === "21"; // knob right = OFF

            const advancedSearch = document.getElementById("advancedSearch");
            const description = document.getElementById("description");

            if (isOff) {
                // Turn ON → knob left, bg blue
                knob.setAttribute("x", "1");
                bg.setAttribute("fill", "#0080FF");
                bg.setAttribute("stroke", "#0080FF");

                advancedSearch.style.display = "block";

                description.classList.remove("col-md-9");
                description.classList.add("col-md-3");

            } else {

                // Turn OFF → knob right, bg grey
                knob.setAttribute("x", "21");
                bg.setAttribute("fill", "#BABABA");
                bg.setAttribute("stroke", "#BABABA");

                advancedSearch.style.display = "none";

                description.classList.remove("col-md-3");
                description.classList.add("col-md-9");

            }
        });

    </script>
}
